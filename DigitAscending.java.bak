		int n=5361793;
		int res=0;
		
		for (int i=1;i<=9;i++)
		{
			int t=n;
			while (t!=0)
			{
				if (t%10==i)
				{
					res=res*10+t%10;
				}
				t/=10;
			}
		}
		System.out.println(res);
	}
}
